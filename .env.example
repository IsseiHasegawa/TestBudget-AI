# Used from Phase 2 onward. Phase 1 does not need any of this.
# Do not guess the model id or the endpoint. Read both off the model page at
# build.nvidia.com and set them here, so they can be changed without a code edit.
NVIDIA_API_KEY=
NEMOTRON_BASE_URL=
NEMOTRON_MODEL=

# How much of the budget the ranking may spend before the scheduler gives up
# and falls back. Defaults are 0.15 and 10.0, tuned for fast feedback; at a 60s
# budget that leaves the first attempt about 6s against a ~6s median latency,
# so roughly half of calls fall back. Raise the cap to trade test time for a
# better chance the model answers.
TESTBUDGET_AI_BUDGET_FRACTION=
TESTBUDGET_AI_MAX_SECONDS=
